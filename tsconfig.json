{
  "//": "Checagem de tipos (npm run check) do servidor e dos módulos compartilhados com o navegador. O modo strict está ligado por partes: falta noImplicitAny, que pede tipos em quase todas as funções. Os scripts do jogo (assets/app-*.js) dividem variáveis globais entre si e ficam de fora até virarem módulos ES.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": false,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "server.js",
    "lib/validate.js",
    "lib/profanity.js",
    "lib/persist.js",
    "lib/report-hook.js",
    "lib/records.js",
    "lib/reports.js",
    "lib/banmgr.js",
    "lib/assets.js",
    "lib/capacity.js",
    "lib/admission.js",
    "lib/bots.js",
    "lib/netutil.js",
    "lib/limits.js",
    "lib/compress.js",
    "lib/radio.js",
    "lib/room.js",
    "lib/karaoke.js",
    "lib/video.js",
    "assets/catalog.js",
    "assets/recovery.js"
  ]
}
