{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyke3D",
  "version": "../../package.json",
  "identifier": "io.github.noturno-strange.skyke3d",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
